# Copy to .env and configure provider credentials locally.
# Area logins: fixed username admin + a listed six-digit postal PIN.
CIVICFLUX_DB=var/civicflux.sqlite3
# Optional verified HTTP JSON source endpoints; unconfigured feeds abstain.
CIVICFLUX_IMD_URL=
CIVICFLUX_CPCB_URL=
CIVICFLUX_PUBLIC_FEEDS=1
DATA_GOV_IN_API_KEY=
# CIVICFLUX_ROOT defaults to the directory containing project_paths.py.

# Optional Google Maps browser key: restrict to Maps JavaScript API and approved HTTP referrers.
# This key is visible to the browser by design; never use an unrestricted server credential.
VITE_GOOGLE_MAPS_API_KEY=

# Optional live WAQI station data (server-only; never use VITE_ for this token).
WAQI_API_TOKEN=
# Optional OpenWeather precipitation tile access (server-only).
OPENWEATHERMAP_API_KEY=

# Complaint receipts: use a Gmail App Password, never your normal login password.
SMTP_USER=
SMTP_PASS=
SMTP_PORT=465

# In-app alert thresholds; notifications poll only while the page is open.
CIVICFLUX_ALERT_RAIN_MM=10
CIVICFLUX_ALERT_TEMP_C=40
CIVICFLUX_ALERT_US_AQI=151
# SMTP_USER must be a dedicated mailbox you actually own; no mailbox is created by setup.

# Civilian SMS OTP: server-only. Await approved DLT Entity, Sender and SMS OTP template.
# Create the SMS-only Smart OTP ID in Fast2SMS, then set these private values.
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=

# Optional paid Quick SMS, only after explicit owner approval (no DLT template needed).
# Default mode remains smart. A Quick SMS attempt consumes its slot even on failure.
FAST2SMS_MODE=smart
FAST2SMS_QUICK_LIMIT=1
FAST2SMS_QUICK_ACTIVATED_AT=0

# Support follow-ups: these preferred names also work with the existing SMTP_* aliases.
# Set SENDER_EMAIL=civicflux10@gmail.com privately and use its Gmail App Password.
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_HOST=smtp.gmail.com
# ssl (implicit TLS, normally 465) or starttls (normally 587); plaintext is refused.
SMTP_SECURITY=ssl
SMTP_TIMEOUT=10
